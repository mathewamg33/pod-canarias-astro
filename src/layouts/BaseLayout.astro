---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Podcasts educativos realizados por alumnos de 5º de Primaria del CEIP Mirador del Mar.' } = Astro.props;
const currentPath = Astro.url.pathname;

const functionalLinks = [
  { href: '/', label: 'Inicio' },
  { href: '/podcasts', label: 'Episodios' },
];

const fictitiousLinks = [
  { label: 'Noticias' },
  { label: 'Proyectos y Actividades' },
  { label: 'Familia' },
  { label: 'Celebraciones' },
  { label: 'Calendario Escolar' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | SOMOS LA VOZ</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class="min-h-screen flex flex-col bg-[#f8f9fb]">


    <!-- Header principal -->
    <header class="bg-[#e8f4fd] border-b border-[#c5dff5] sticky top-0 z-50">
      <div class="max-w-[1200px] mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
        <!-- Logo / Marca -->
        <a href="/" class="flex items-center gap-2.5 group cursor-pointer flex-shrink-0" aria-label="SOMOS LA VOZ - Inicio">
          <div class="w-9 h-9 bg-[#002068] rounded-full flex items-center justify-center flex-shrink-0">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8" aria-hidden="true">
              <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
              <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
              <line x1="12" y1="19" x2="12" y2="23"/>
              <line x1="8" y1="23" x2="16" y2="23"/>
            </svg>
          </div>
          <div class="leading-tight">
            <span class="block font-bold text-[#002068] text-base group-hover:text-[#003399] transition-colors duration-200">
              SOMOS LA VOZ
            </span>
            <span class="block text-[10px] text-[#747684] font-medium tracking-wide">
              CEIP MIRADOR DEL MAR · 5º PRIMARIA
            </span>
          </div>
        </a>

        <!-- Nav desktop -->
        <nav class="hidden lg:flex items-center gap-0.5 overflow-x-auto" aria-label="Navegación principal">
          {functionalLinks.map(link => (
            <a
              href={link.href}
              class={`px-3 py-2 text-sm font-semibold rounded whitespace-nowrap transition-colors duration-200 cursor-pointer ${
                currentPath === link.href || (link.href === '/podcasts' && currentPath.startsWith('/podcasts'))
                  ? 'text-[#002068] border-b-2 border-[#002068]'
                  : 'text-[#444653] hover:text-[#002068] hover:bg-white/60'
              }`}
              aria-current={currentPath === link.href ? 'page' : undefined}
            >
              {link.label}
            </a>
          ))}
          <span class="mx-1 text-[#a8cce8]" aria-hidden="true">|</span>
          {fictitiousLinks.map(link => (
            <span
              class="px-3 py-2 text-sm text-[#8aa8c4] whitespace-nowrap cursor-default select-none"
              aria-hidden="true"
              title="Sección de demostración"
            >
              {link.label}
            </span>
          ))}
        </nav>

        <!-- Mobile menu button -->
        <button
          id="mobile-menu-btn"
          class="lg:hidden p-2 rounded text-[#444653] hover:bg-white/60 transition-colors duration-200 cursor-pointer flex-shrink-0"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <line x1="3" y1="6" x2="21" y2="6"/>
            <line x1="3" y1="12" x2="21" y2="12"/>
            <line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
        </button>
      </div>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="lg:hidden hidden border-t border-[#c5dff5] bg-[#e8f4fd]">
        <nav class="px-4 py-3 flex flex-col gap-0.5" aria-label="Navegación móvil">
          {functionalLinks.map(link => (
            <a
              href={link.href}
              class={`px-3 py-2.5 text-sm font-semibold rounded transition-colors duration-200 cursor-pointer ${
                currentPath === link.href || (link.href === '/podcasts' && currentPath.startsWith('/podcasts'))
                  ? 'text-[#002068] bg-white/60'
                  : 'text-[#444653] hover:text-[#002068] hover:bg-white/60'
              }`}
            >
              {link.label}
            </a>
          ))}
          <div class="my-1 border-t border-[#c5dff5]"></div>
          {fictitiousLinks.map(link => (
            <span class="px-3 py-2 text-sm text-[#8aa8c4] cursor-default">
              {link.label}
            </span>
          ))}
        </nav>
      </div>
    </header>

    <!-- Contenido principal -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-[#e0e3e5]">
      <div class="max-w-[1200px] mx-auto px-4 sm:px-6 py-10">
        <div class="flex flex-col md:flex-row justify-between gap-8">
          <div>
            <div class="flex items-center gap-2 mb-2">
              <div class="w-7 h-7 bg-[#002068] rounded-full flex items-center justify-center">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" aria-hidden="true">
                  <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
                  <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
                  <line x1="12" y1="19" x2="12" y2="23"/>
                  <line x1="8" y1="23" x2="16" y2="23"/>
                </svg>
              </div>
              <span class="font-bold text-[#002068] text-base">SOMOS LA VOZ</span>
            </div>
            <p class="text-xs text-[#747684] mb-1 font-medium">CEIP Mirador del Mar · 5º Primaria</p>
            <p class="text-sm text-[#444653] max-w-xs leading-relaxed">
              Proyecto de podcast educativo del alumnado de 5º de Primaria.
            </p>
          </div>

          <div class="flex flex-col sm:flex-row gap-8">
            <div>
              <h3 class="text-xs font-semibold text-[#191c1e] uppercase tracking-wider mb-3">Secciones</h3>
              <ul class="space-y-2">
                <li><a href="/" class="text-sm text-[#444653] hover:text-[#002068] transition-colors duration-200 cursor-pointer">Inicio</a></li>
                <li><a href="/podcasts" class="text-sm text-[#444653] hover:text-[#002068] transition-colors duration-200 cursor-pointer">Episodios</a></li>
              </ul>
            </div>
            <div>
              <h3 class="text-xs font-semibold text-[#191c1e] uppercase tracking-wider mb-3">Legal</h3>
              <ul class="space-y-2">
                <li><span class="text-sm text-[#747684]">Aviso Legal</span></li>
                <li><span class="text-sm text-[#747684]">Privacidad</span></li>
                <li><span class="text-sm text-[#747684]">Accesibilidad</span></li>
              </ul>
            </div>
          </div>
        </div>

        <div class="mt-8 pt-6 border-t border-[#e0e3e5] text-center">
          <p class="text-xs text-[#747684]">
            © Gobierno de Canarias. Consejería de Educación, Formación Profesional, Actividad Física y Deportes.
          </p>
        </div>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      btn?.addEventListener('click', () => {
        const isOpen = !menu?.classList.contains('hidden');
        menu?.classList.toggle('hidden');
        btn.setAttribute('aria-expanded', String(!isOpen));
      });
    </script>
  </body>
</html>
