---
import BaseLayout from '../layouts/BaseLayout.astro';
import PodcastCard from '../components/PodcastCard.astro';
import { getCollection } from 'astro:content';

const allPodcasts = await getCollection('podcasts');
const latestPodcasts = allPodcasts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 6);
---

<BaseLayout title="Inicio" description="Podcasts realizados por el alumnado de Educación Primaria de Canarias.">

  <!-- Hero -->
  <section class="bg-white border-b border-[#e0e3e5]">
    <div class="max-w-[1200px] mx-auto px-6 py-16 md:py-20">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <h1 class="text-4xl md:text-5xl font-bold text-[#191c1e] leading-tight mb-4">
            La voz de<br /><span class="text-[#002068]">nuestras aulas.</span>
          </h1>
          <p class="text-lg text-[#444653] leading-relaxed mb-8 max-w-md">
            Podcasts realizados por el alumnado de Educación Primaria de Canarias.
            Descubre el talento y la creatividad de nuestros estudiantes a través de las ondas.
          </p>
          <div class="flex flex-wrap gap-3">
            <a
              href="/podcasts"
              class="inline-flex items-center gap-2 bg-[#002068] text-white font-semibold px-6 py-3 rounded hover:bg-[#003399] transition-colors duration-200 cursor-pointer"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="white" aria-hidden="true">
                <polygon points="5,3 19,12 5,21"/>
              </svg>
              Explorar Podcasts
            </a>
            <a
              href="/podcasts"
              class="inline-flex items-center gap-2 border border-[#002068] text-[#002068] font-semibold px-6 py-3 rounded hover:bg-[#f2f4f6] transition-colors duration-200 cursor-pointer"
            >
              Saber más
            </a>
          </div>
        </div>

        <!-- Ilustración -->
        <div class="hidden md:flex justify-center">
          <div class="relative w-80 h-64 bg-gradient-to-br from-[#eceef0] to-[#e0e3e5] rounded-lg flex items-center justify-center border border-[#c4c5d5]">
            <div class="text-center">
              <div class="w-20 h-20 bg-[#002068] rounded-full flex items-center justify-center mx-auto mb-4">
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" aria-hidden="true">
                  <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
                  <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
                  <line x1="12" y1="19" x2="12" y2="23"/>
                  <line x1="8" y1="23" x2="16" y2="23"/>
                </svg>
              </div>
              <p class="text-sm text-[#444653] font-semibold">Radio Escolar Canaria</p>
              <p class="text-xs text-[#747684] mt-1">Alumnos de Primaria</p>
            </div>
            <!-- Ondas decorativas -->
            <div class="absolute -right-3 top-1/2 -translate-y-1/2 flex flex-col gap-1">
              {[32, 48, 40, 52, 36].map((h) => (
                <div class="w-1 bg-[#002068] rounded-full opacity-20" style={`height: ${h}px`}></div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Últimos episodios -->
  <section class="max-w-[1200px] mx-auto px-6 py-14">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-2xl font-semibold text-[#191c1e]">Últimos Episodios</h2>
      <a
        href="/podcasts"
        class="text-sm font-semibold text-[#002068] hover:text-[#003399] transition-colors duration-200 cursor-pointer flex items-center gap-1"
      >
        Ver todos
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <polyline points="9,18 15,12 9,6"/>
        </svg>
      </a>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {latestPodcasts.map((podcast) => (
        <PodcastCard
          slug={podcast.id}
          title={podcast.data.title}
          school={podcast.data.school}
          date={podcast.data.date}
          subject={podcast.data.subject}
          level={podcast.data.level}
          duration={podcast.data.duration}
          description={podcast.data.description}
        />
      ))}
    </div>

    <div class="mt-10 text-center">
      <a
        href="/podcasts"
        class="inline-flex items-center gap-2 border border-[#002068] text-[#002068] font-semibold px-8 py-3 rounded hover:bg-[#f2f4f6] transition-colors duration-200 cursor-pointer"
      >
        Cargar más podcasts
      </a>
    </div>
  </section>

  <!-- Banner informativo -->
  <section class="bg-[#002068] text-white">
    <div class="max-w-[1200px] mx-auto px-6 py-12 text-center">
      <h2 class="text-2xl font-semibold mb-3">Un proyecto educativo para Canarias</h2>
      <p class="text-[#b5c4ff] max-w-2xl mx-auto leading-relaxed">
        Podcanarias Educativo es una iniciativa de la Consejería de Educación del Gobierno de Canarias
        para impulsar la expresión oral, la creatividad y las competencias digitales en Educación Primaria.
      </p>
    </div>
  </section>

</BaseLayout>
