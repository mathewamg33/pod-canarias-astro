---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PodcastCard from '../../components/PodcastCard.astro';
import { getCollection } from 'astro:content';

const allPodcasts = await getCollection('podcasts');
const sortedPodcasts = allPodcasts.sort(
  (a, b) => (a.data.episodeOrder ?? 0) - (b.data.episodeOrder ?? 0)
);
---

<BaseLayout title="Episodios" description="Los 8 episodios del proyecto SOMOS LA VOZ, realizados por el alumnado de 5º de Primaria del CEIP Mirador del Mar.">

  <!-- Cabecera de sección -->
  <div class="bg-white border-b border-[#e0e3e5]">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 py-10">
      <!-- Breadcrumb -->
      <nav aria-label="Ruta de navegación" class="mb-4">
        <ol class="flex items-center gap-2 text-sm text-[#747684]">
          <li><a href="/" class="hover:text-[#002068] transition-colors duration-200 cursor-pointer">Inicio</a></li>
          <li aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="inline" aria-hidden="true">
              <polyline points="9,18 15,12 9,6"/>
            </svg>
          </li>
          <li class="text-[#191c1e] font-semibold" aria-current="page">Episodios</li>
        </ol>
      </nav>
      <h1 class="text-2xl sm:text-3xl font-bold text-[#191c1e]">Todos los episodios</h1>
      <p class="text-[#444653] mt-1 text-sm sm:text-base">
        SOMOS LA VOZ · CEIP Mirador del Mar · 5º Primaria
      </p>
      <p class="text-[#747684] text-sm mt-1">{sortedPodcasts.length} episodios</p>
    </div>
  </div>

  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 py-8">
    <!-- Grid de podcasts -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {sortedPodcasts.map((podcast) => (
          <PodcastCard
            slug={podcast.id}
            title={podcast.data.title}
            school={podcast.data.school}
            date={podcast.data.date}
            subject={podcast.data.subject}
            level={podcast.data.level}
            duration={podcast.data.duration}
            description={podcast.data.description}
            episodeOrder={podcast.data.episodeOrder}
            coverImage={podcast.data.coverImage}
            efemeride={podcast.data.efemeride}
          />
      ))}
    </div>
  </div>
</BaseLayout>
