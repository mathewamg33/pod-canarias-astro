---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PodcastCard from '../../components/PodcastCard.astro';
import { getCollection } from 'astro:content';

const allPodcasts = await getCollection('podcasts');
const sortedPodcasts = allPodcasts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const levels = ['Todos', '1º Primaria', '2º Primaria', '3º Primaria', '4º Primaria', '5º Primaria', '6º Primaria'];
const subjects = ['Ciencias', 'Historia', 'Lengua', 'Entrevistas', 'Matemáticas', 'Cultura Canaria', 'Medio Ambiente'];
---

<BaseLayout title="Podcasts" description="Todos los podcasts educativos realizados por alumnos de Educación Primaria de Canarias.">

  <!-- Cabecera de sección -->
  <div class="bg-white border-b border-[#e0e3e5]">
    <div class="max-w-[1200px] mx-auto px-6 py-10">
      <!-- Breadcrumb -->
      <nav aria-label="Ruta de navegación" class="mb-4">
        <ol class="flex items-center gap-2 text-sm text-[#747684]">
          <li><a href="/" class="hover:text-[#002068] transition-colors duration-200 cursor-pointer">Inicio</a></li>
          <li aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="inline" aria-hidden="true">
              <polyline points="9,18 15,12 9,6"/>
            </svg>
          </li>
          <li class="text-[#191c1e] font-semibold" aria-current="page">Podcasts</li>
        </ol>
      </nav>
      <h1 class="text-3xl font-bold text-[#191c1e]">Todos los episodios</h1>
      <p class="text-[#444653] mt-2">{sortedPodcasts.length} podcasts disponibles</p>
    </div>
  </div>

  <div class="max-w-[1200px] mx-auto px-6 py-8">
    <!-- Filtros -->
    <div class="bg-white border border-[#e0e3e5] rounded p-5 mb-8">
      <div class="flex flex-col md:flex-row gap-6">
        <!-- Filtro por nivel -->
        <div class="flex-1">
          <p class="text-xs font-semibold text-[#444653] uppercase tracking-wider mb-3">Filtrar por nivel</p>
          <div class="flex flex-wrap gap-2" id="level-filters" role="group" aria-label="Filtrar por nivel educativo">
            {levels.map((level, i) => (
              <button
                class={`level-filter text-sm px-3 py-1.5 rounded border transition-colors duration-200 cursor-pointer font-medium ${
                  i === 0
                    ? 'bg-[#002068] text-white border-[#002068]'
                    : 'bg-white text-[#444653] border-[#c4c5d5] hover:border-[#002068] hover:text-[#002068]'
                }`}
                data-level={level}
                aria-pressed={i === 0 ? 'true' : 'false'}
              >
                {level}
              </button>
            ))}
          </div>
        </div>

        <!-- Filtro por temática -->
        <div class="flex-1">
          <p class="text-xs font-semibold text-[#444653] uppercase tracking-wider mb-3">Temática</p>
          <div class="flex flex-wrap gap-2" id="subject-filters" role="group" aria-label="Filtrar por temática">
            {subjects.map((subject) => (
              <button
                class="subject-filter text-sm px-3 py-1.5 rounded border border-[#c4c5d5] bg-white text-[#444653] hover:border-[#002068] hover:text-[#002068] transition-colors duration-200 cursor-pointer font-medium"
                data-subject={subject}
                aria-pressed="false"
              >
                {subject}
              </button>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Cabecera del listado -->
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-xl font-semibold text-[#191c1e]">Episodios recientes</h2>
      <p class="text-sm text-[#747684]" id="results-count">{sortedPodcasts.length} episodios</p>
    </div>

    <!-- Grid de podcasts -->
    <div id="podcasts-grid" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {sortedPodcasts.map((podcast) => (
        <div
          class="podcast-item"
          data-level={podcast.data.level}
          data-subject={podcast.data.subject}
        >
          <PodcastCard
            slug={podcast.id}
            title={podcast.data.title}
            school={podcast.data.school}
            date={podcast.data.date}
            subject={podcast.data.subject}
            level={podcast.data.level}
            duration={podcast.data.duration}
            description={podcast.data.description}
          />
        </div>
      ))}
    </div>

    <!-- Estado vacío -->
    <div id="empty-state" class="hidden text-center py-20">
      <div class="w-16 h-16 bg-[#eceef0] rounded-full flex items-center justify-center mx-auto mb-4">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#747684" stroke-width="1.5" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </div>
      <p class="text-[#444653] font-semibold">No se encontraron episodios</p>
      <p class="text-sm text-[#747684] mt-1">Prueba con otros filtros</p>
    </div>
  </div>
</BaseLayout>

<script>
  let activeLevel = 'Todos';
  let activeSubject: string | null = null;

  const levelBtns = document.querySelectorAll<HTMLButtonElement>('.level-filter');
  const subjectBtns = document.querySelectorAll<HTMLButtonElement>('.subject-filter');
  const items = document.querySelectorAll<HTMLElement>('.podcast-item');
  const emptyState = document.getElementById('empty-state');
  const resultsCount = document.getElementById('results-count');

  function applyFilters() {
    let visible = 0;
    items.forEach((item) => {
      const level = item.dataset.level ?? '';
      const subject = item.dataset.subject ?? '';
      const matchLevel = activeLevel === 'Todos' || level === activeLevel;
      const matchSubject = activeSubject === null || subject === activeSubject;
      const show = matchLevel && matchSubject;
      item.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    if (emptyState) emptyState.classList.toggle('hidden', visible > 0);
    if (resultsCount) resultsCount.textContent = `${visible} episodio${visible !== 1 ? 's' : ''}`;
  }

  levelBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeLevel = btn.dataset.level ?? 'Todos';
      levelBtns.forEach((b) => {
        const isActive = b.dataset.level === activeLevel;
        b.classList.toggle('bg-[#002068]', isActive);
        b.classList.toggle('text-white', isActive);
        b.classList.toggle('border-[#002068]', isActive);
        b.classList.toggle('bg-white', !isActive);
        b.classList.toggle('text-[#444653]', !isActive);
        b.classList.toggle('border-[#c4c5d5]', !isActive);
        b.setAttribute('aria-pressed', String(isActive));
      });
      applyFilters();
    });
  });

  subjectBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const subject = btn.dataset.subject ?? '';
      if (activeSubject === subject) {
        activeSubject = null;
        btn.classList.remove('bg-[#fcd400]', 'text-[#221b00]', 'border-[#fcd400]');
        btn.classList.add('bg-white', 'text-[#444653]', 'border-[#c4c5d5]');
        btn.setAttribute('aria-pressed', 'false');
      } else {
        activeSubject = subject;
        subjectBtns.forEach((b) => {
          b.classList.remove('bg-[#fcd400]', 'text-[#221b00]', 'border-[#fcd400]');
          b.classList.add('bg-white', 'text-[#444653]', 'border-[#c4c5d5]');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('bg-[#fcd400]', 'text-[#221b00]', 'border-[#fcd400]');
        btn.classList.remove('bg-white', 'text-[#444653]', 'border-[#c4c5d5]');
        btn.setAttribute('aria-pressed', 'true');
      }
      applyFilters();
    });
  });
</script>
