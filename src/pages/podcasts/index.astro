---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PodcastCard from '../../components/PodcastCard.astro';
import { getCollection } from 'astro:content';

const allPodcasts = await getCollection('podcasts');
const episodes = allPodcasts.sort((a, b) => {
  const orderA = a.data.episodeOrder ?? 99;
  const orderB = b.data.episodeOrder ?? 99;
  if (orderA !== orderB) return orderA - orderB;
  return a.data.date.getTime() - b.data.date.getTime();
});
---

<BaseLayout title="Episodios" description="Los ocho episodios del proyecto SOMOS LA VOZ, grabados por el alumnado de 5º de Primaria del CEIP Mirador del Mar.">

  <!-- Cabecera -->
  <div class="bg-white border-b border-[#e0e3e5]">
    <div class="max-w-[1200px] mx-auto px-6 py-10">
      <nav aria-label="Ruta de navegación" class="mb-4">
        <ol class="flex items-center gap-2 text-sm text-[#747684]">
          <li><a href="/" class="hover:text-[#002068] transition-colors duration-200 cursor-pointer">Inicio</a></li>
          <li aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="inline">
              <polyline points="9,18 15,12 9,6"/>
            </svg>
          </li>
          <li class="text-[#191c1e] font-semibold" aria-current="page">Episodios</li>
        </ol>
      </nav>
      <h1 class="text-3xl font-bold text-[#191c1e]">Los 8 episodios</h1>
      <p class="text-[#444653] mt-2">
        Proyecto <strong>SOMOS LA VOZ</strong> · CEIP Mirador del Mar · 5º Primaria · Curso 2025-2026
      </p>
    </div>
  </div>

  <!-- Grid de episodios -->
  <div class="max-w-[1200px] mx-auto px-6 py-10">
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {episodes.map((podcast) => (
        <PodcastCard
          slug={podcast.id}
          title={podcast.data.title}
          school={podcast.data.school}
          date={podcast.data.date}
          subject={podcast.data.subject}
          level={podcast.data.level}
          duration={podcast.data.duration}
          description={podcast.data.description}
          episodeOrder={podcast.data.episodeOrder}
        />
      ))}
    </div>
  </div>

</BaseLayout>
