---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, getEntry, render } from 'astro:content';

export async function getStaticPaths() {
  const podcasts = await getCollection('podcasts');
  return podcasts.map((podcast) => ({
    params: { slug: podcast.id },
  }));
}

const { slug } = Astro.params;
const podcast = await getEntry('podcasts', slug!);

if (!podcast) {
  return Astro.redirect('/podcasts');
}

const { Content } = await render(podcast);

const allPodcasts = await getCollection('podcasts');
const related = allPodcasts
  .filter((p) => p.id !== slug && p.data.subject === podcast.data.subject)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const formattedDate = podcast.data.date.toLocaleDateString('es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const subjectColors: Record<string, string> = {
  'Ciencias': 'bg-[#e8f4fd] text-[#004540] border-[#2ebaae]',
  'Historia': 'bg-[#fff8e1] text-[#6e5c00] border-[#fcd400]',
  'Lengua': 'bg-[#e8eeff] text-[#002068] border-[#b5c4ff]',
  'Entrevistas': 'bg-[#f2f4f6] text-[#444653] border-[#c4c5d5]',
  'Matemáticas': 'bg-[#fff0f0] text-[#93000a] border-[#ffdad6]',
  'Cultura Canaria': 'bg-[#e8f4fd] text-[#004540] border-[#2ebaae]',
  'Medio Ambiente': 'bg-[#e8f4ee] text-[#004540] border-[#2ebaae]',
};
const subjectColor = subjectColors[podcast.data.subject] ?? subjectColors['Entrevistas'];
---

<BaseLayout title={podcast.data.title} description={podcast.data.description}>

  <!-- Breadcrumb -->
  <div class="bg-white border-b border-[#e0e3e5]">
    <div class="max-w-[1200px] mx-auto px-6 py-4">
      <nav aria-label="Ruta de navegación">
        <ol class="flex items-center gap-2 text-sm text-[#747684] flex-wrap">
          <li><a href="/" class="hover:text-[#002068] transition-colors duration-200 cursor-pointer">Inicio</a></li>
          <li aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="inline">
              <polyline points="9,18 15,12 9,6"/>
            </svg>
          </li>
          <li><a href="/podcasts" class="hover:text-[#002068] transition-colors duration-200 cursor-pointer">Podcasts</a></li>
          <li aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="inline">
              <polyline points="9,18 15,12 9,6"/>
            </svg>
          </li>
          <li class="text-[#191c1e] truncate max-w-[200px]" aria-current="page">{podcast.data.title}</li>
        </ol>
      </nav>
    </div>
  </div>

  <!-- Contenido principal -->
  <div class="max-w-[1200px] mx-auto px-6 py-10">
    <div class="grid lg:grid-cols-3 gap-10">

      <!-- Columna principal -->
      <div class="lg:col-span-2">

        <!-- Etiquetas -->
        <div class="flex flex-wrap gap-2 mb-5">
          <span class={`text-xs font-semibold px-3 py-1 rounded border ${subjectColor}`}>
            {podcast.data.subject}
          </span>
          <span class="text-xs font-semibold px-3 py-1 rounded bg-[#002068] text-white">
            {podcast.data.level}
          </span>
        </div>

        <!-- Título -->
        <h1 class="text-3xl md:text-4xl font-bold text-[#191c1e] leading-tight mb-5">
          {podcast.data.title}
        </h1>

        <!-- Meta -->
        <div class="flex flex-wrap items-center gap-4 mb-8 text-sm text-[#444653]">
          <span class="flex items-center gap-1.5">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
              <polyline points="9,22 9,12 15,12 15,22"/>
            </svg>
            {podcast.data.school}
          </span>
          <span class="text-[#c4c5d5]" aria-hidden="true">·</span>
          <time datetime={podcast.data.date.toISOString()} class="flex items-center gap-1.5">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
              <line x1="16" y1="2" x2="16" y2="6"/>
              <line x1="8" y1="2" x2="8" y2="6"/>
              <line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
            {formattedDate}
          </time>
          <span class="text-[#c4c5d5]" aria-hidden="true">·</span>
          <span class="flex items-center gap-1.5">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12,6 12,12 16,14"/>
            </svg>
            {podcast.data.duration === '--:--' ? 'Próximamente' : `${podcast.data.duration} min`}
          </span>
        </div>

        <!-- Reproductor de audio -->
        <div class="bg-white border border-[#e0e3e5] rounded p-5 mb-8">
          {podcast.data.audioFile ? (
            <div>
              <p class="text-xs text-[#747684] font-semibold uppercase tracking-wider mb-3">Reproducir episodio</p>
              <audio
                controls
                class="w-full"
                preload="metadata"
                aria-label={`Reproducir: ${podcast.data.title}`}
              >
                <source src={podcast.data.audioFile} type="audio/mpeg" />
                Tu navegador no soporta el elemento de audio.
              </audio>
            </div>
          ) : (
            <div class="flex items-center gap-4">
              <div class="w-14 h-14 bg-[#eceef0] rounded-full flex items-center justify-center flex-shrink-0">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="#747684" aria-hidden="true">
                  <polygon points="5,3 19,12 5,21"/>
                </svg>
              </div>
              <div>
                <p class="text-sm font-semibold text-[#191c1e]">Audio próximamente</p>
                <p class="text-sm text-[#747684] mt-0.5">
                  Este episodio está siendo grabado y estará disponible pronto.
                </p>
              </div>
            </div>
          )}
        </div>

        <!-- Descripción del episodio -->
        <section class="mb-8">
          <h2 class="text-xl font-semibold text-[#191c1e] mb-4">Descripción del episodio</h2>
          <div class="text-[#444653] leading-relaxed text-base prose prose-sm max-w-none">
            <Content />
          </div>
        </section>

        <!-- Objetivos y competencias -->
        {(podcast.data.objectives || podcast.data.competencies) && (
          <section class="bg-white border border-[#e0e3e5] rounded p-6 mb-8">
            <div class="grid sm:grid-cols-2 gap-6">
              {podcast.data.objectives && podcast.data.objectives.length > 0 && (
                <div>
                  <h3 class="text-xs font-semibold text-[#444653] uppercase tracking-wider mb-4">
                    Objetivos Didácticos
                  </h3>
                  <ul class="space-y-2">
                    {podcast.data.objectives.map((obj) => (
                      <li class="flex items-start gap-2 text-sm text-[#444653]">
                        <span class="mt-1.5 w-1.5 h-1.5 bg-[#002068] rounded-full flex-shrink-0" aria-hidden="true"></span>
                        {obj}
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {podcast.data.competencies && podcast.data.competencies.length > 0 && (
                <div>
                  <h3 class="text-xs font-semibold text-[#444653] uppercase tracking-wider mb-4">
                    Competencias
                  </h3>
                  <div class="flex flex-wrap gap-2">
                    {podcast.data.competencies.map((comp) => (
                      <span class="text-xs bg-[#e8f4fd] text-[#004540] border border-[#2ebaae] px-2.5 py-1 rounded font-medium">
                        {comp}
                      </span>
                    ))}
                  </div>
                </div>
              )}
            </div>
          </section>
        )}

        <!-- Acciones -->
        <div class="flex flex-wrap gap-3">
          {podcast.data.audioFile && (
            <a
              href={podcast.data.audioFile}
              download
              class="inline-flex items-center gap-2 bg-[#002068] text-white font-semibold px-5 py-2.5 rounded hover:bg-[#003399] transition-colors duration-200 cursor-pointer"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="7,10 12,15 17,10"/>
                <line x1="12" y1="15" x2="12" y2="3"/>
              </svg>
              Descargar Podcast
            </a>
          )}
          <button
            id="share-btn"
            class="inline-flex items-center gap-2 border border-[#002068] text-[#002068] font-semibold px-5 py-2.5 rounded hover:bg-[#f2f4f6] transition-colors duration-200 cursor-pointer"
            aria-label="Compartir episodio"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="18" cy="5" r="3"/>
              <circle cx="6" cy="12" r="3"/>
              <circle cx="18" cy="19" r="3"/>
              <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
              <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
            </svg>
            Compartir
          </button>
        </div>
      </div>

      <!-- Columna lateral -->
      <aside class="space-y-6">

        <!-- Episodios relacionados -->
        {related.length > 0 && (
          <div class="bg-white border border-[#e0e3e5] rounded p-5">
            <h3 class="text-base font-semibold text-[#191c1e] mb-4 flex items-center gap-2">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#002068" stroke-width="2" aria-hidden="true">
                <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
                <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
                <line x1="12" y1="19" x2="12" y2="23"/>
                <line x1="8" y1="23" x2="16" y2="23"/>
              </svg>
              Episodios relacionados
            </h3>
            <ul class="space-y-4 divide-y divide-[#eceef0]">
              {related.map((rel) => (
                <li class="pt-4 first:pt-0">
                  <a href={`/podcasts/${rel.id}`} class="group flex gap-3 cursor-pointer">
                    <div class="w-16 h-16 bg-[#eceef0] rounded flex-shrink-0 flex items-center justify-center group-hover:bg-[#e0e3e5] transition-colors duration-200">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="#002068" aria-hidden="true">
                        <polygon points="5,3 19,12 5,21"/>
                      </svg>
                    </div>
                    <div class="min-w-0">
                      <p class="text-sm font-semibold text-[#191c1e] leading-snug group-hover:text-[#002068] transition-colors duration-200 line-clamp-2">
                        {rel.data.title}
                      </p>
                      <p class="text-xs text-[#747684] mt-1">{rel.data.school} · {rel.data.level}</p>
                      <p class="text-xs text-[#747684] mt-0.5 flex items-center gap-1">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                          <circle cx="12" cy="12" r="10"/>
                          <polyline points="12,6 12,12 16,14"/>
                        </svg>
                        {rel.data.duration} min
                      </p>
                    </div>
                  </a>
                </li>
              ))}
            </ul>
            <a
              href="/podcasts"
              class="mt-4 w-full flex items-center justify-center text-sm font-semibold text-[#002068] border border-[#002068] rounded py-2 hover:bg-[#f2f4f6] transition-colors duration-200 cursor-pointer"
            >
              Ver todos los episodios
            </a>
          </div>
        )}

        <!-- Info del proyecto -->
        <div class="bg-[#002068] text-white rounded p-5">
          <h3 class="text-base font-bold mb-2">SOMOS LA VOZ</h3>
          <p class="text-xs text-[#b5c4ff] font-semibold mb-3 tracking-wide">CEIP MIRADOR DEL MAR · 5º PRIMARIA</p>
          <p class="text-sm text-[#b5c4ff] leading-relaxed mb-4">
            Proyecto interdisciplinar de Educación en Valores Cívicos y Lengua Castellana. Ocho episodios grabados durante el curso 2025-2026.
          </p>
          <a
            href="/"
            class="bg-[#D4A017] text-white rounded px-4 py-2.5 text-sm font-semibold inline-flex items-center gap-2 cursor-pointer hover:bg-[#b88a12] transition-colors duration-200"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
              <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
              <line x1="12" y1="19" x2="12" y2="23"/>
              <line x1="8" y1="23" x2="16" y2="23"/>
            </svg>
            Ver todos los episodios
          </a>
        </div>
      </aside>

    </div>
  </div>

</BaseLayout>

<script>
  const shareBtn = document.getElementById('share-btn');
  shareBtn?.addEventListener('click', async () => {
    if (navigator.share) {
      try {
        await navigator.share({
          title: document.title,
          url: window.location.href,
        });
      } catch (_) {
        // El usuario canceló
      }
    } else {
      await navigator.clipboard.writeText(window.location.href);
      const originalText = shareBtn.innerHTML;
      shareBtn.innerHTML = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="20,6 9,17 4,12"/></svg> ¡Enlace copiado!`;
      setTimeout(() => { shareBtn.innerHTML = originalText; }, 2000);
    }
  });
</script>
