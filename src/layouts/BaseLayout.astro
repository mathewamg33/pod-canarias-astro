---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Podcasts educativos realizados por alumnos de Educación Primaria de Canarias.' } = Astro.props;
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Inicio' },
  { href: '/podcasts', label: 'Podcasts' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | Podcanarias Educativo</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class="min-h-screen flex flex-col bg-[#f8f9fb]">

    <!-- Barra institucional superior -->
    <div class="bg-[#002068] text-white text-xs py-1.5 px-4">
      <div class="max-w-[1200px] mx-auto flex items-center gap-2">
        <!-- Logo C estilizada del Gobierno de Canarias -->
        <svg width="18" height="18" viewBox="0 0 36 36" fill="none" aria-hidden="true">
          <path d="M18 3C9.716 3 3 9.716 3 18C3 26.284 9.716 33 18 33C22.5 33 26.5 31 29.3 27.8L25.5 24.5C23.6 26.6 21 27.9 18 27.9C12.5 27.9 8.1 23.5 8.1 18C8.1 12.5 12.5 8.1 18 8.1C21 8.1 23.6 9.4 25.5 11.5L29.3 8.2C26.5 5 22.5 3 18 3Z" fill="white"/>
          <rect x="20" y="15" width="6" height="6" fill="#fcd400"/>
        </svg>
        <span>Gobierno de Canarias · Consejería de Educación, FP, Actividad Física y Deportes</span>
      </div>
    </div>

    <!-- Header principal -->
    <header class="bg-white border-b border-[#e0e3e5] sticky top-0 z-50">
      <div class="max-w-[1200px] mx-auto px-6 h-16 flex items-center justify-between">
        <!-- Logo / Marca -->
        <a href="/" class="flex items-center gap-3 group cursor-pointer" aria-label="Podcanarias Educativo - Inicio">
          <div class="flex items-center gap-1.5">
            <svg width="28" height="28" viewBox="0 0 36 36" fill="none" aria-hidden="true">
              <path d="M18 3C9.716 3 3 9.716 3 18C3 26.284 9.716 33 18 33C22.5 33 26.5 31 29.3 27.8L25.5 24.5C23.6 26.6 21 27.9 18 27.9C12.5 27.9 8.1 23.5 8.1 18C8.1 12.5 12.5 8.1 18 8.1C21 8.1 23.6 9.4 25.5 11.5L29.3 8.2C26.5 5 22.5 3 18 3Z" fill="#002068"/>
              <rect x="20" y="15" width="6" height="6" fill="#fcd400"/>
            </svg>
          </div>
          <span class="font-bold text-[#002068] text-lg leading-tight group-hover:text-[#003399] transition-colors duration-200">
            Podcanarias<br class="sm:hidden" /><span class="hidden sm:inline"> </span>Educativo
          </span>
        </a>

        <!-- Nav desktop -->
        <nav class="hidden md:flex items-center gap-1" aria-label="Navegación principal">
          {navLinks.map(link => (
            <a
              href={link.href}
              class={`px-4 py-2 text-sm font-semibold rounded transition-colors duration-200 cursor-pointer ${
                currentPath === link.href || (link.href === '/podcasts' && currentPath.startsWith('/podcasts'))
                  ? 'text-[#002068] border-b-2 border-[#002068]'
                  : 'text-[#444653] hover:text-[#002068] hover:bg-[#f2f4f6]'
              }`}
              aria-current={currentPath === link.href ? 'page' : undefined}
            >
              {link.label}
            </a>
          ))}
        </nav>

        <!-- Mobile menu button -->
        <button
          id="mobile-menu-btn"
          class="md:hidden p-2 rounded text-[#444653] hover:bg-[#f2f4f6] transition-colors duration-200 cursor-pointer"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <line x1="3" y1="6" x2="21" y2="6"/>
            <line x1="3" y1="12" x2="21" y2="12"/>
            <line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
        </button>
      </div>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="md:hidden hidden border-t border-[#e0e3e5] bg-white">
        <nav class="px-4 py-3 flex flex-col gap-1" aria-label="Navegación móvil">
          {navLinks.map(link => (
            <a
              href={link.href}
              class={`px-3 py-2.5 text-sm font-semibold rounded transition-colors duration-200 cursor-pointer ${
                currentPath === link.href || (link.href === '/podcasts' && currentPath.startsWith('/podcasts'))
                  ? 'text-[#002068] bg-[#f2f4f6]'
                  : 'text-[#444653] hover:text-[#002068] hover:bg-[#f2f4f6]'
              }`}
            >
              {link.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <!-- Contenido principal -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-[#e0e3e5] mt-16">
      <div class="max-w-[1200px] mx-auto px-6 py-10">
        <div class="flex flex-col md:flex-row justify-between gap-8">
          <div>
            <div class="flex items-center gap-2 mb-3">
              <svg width="24" height="24" viewBox="0 0 36 36" fill="none" aria-hidden="true">
                <path d="M18 3C9.716 3 3 9.716 3 18C3 26.284 9.716 33 18 33C22.5 33 26.5 31 29.3 27.8L25.5 24.5C23.6 26.6 21 27.9 18 27.9C12.5 27.9 8.1 23.5 8.1 18C8.1 12.5 12.5 8.1 18 8.1C21 8.1 23.6 9.4 25.5 11.5L29.3 8.2C26.5 5 22.5 3 18 3Z" fill="#002068"/>
                <rect x="20" y="15" width="6" height="6" fill="#fcd400"/>
              </svg>
              <span class="font-bold text-[#002068] text-base">Podcanarias Educativo</span>
            </div>
            <p class="text-sm text-[#444653] max-w-xs leading-relaxed">
              Podcasts realizados por el alumnado de Educación Primaria de Canarias.
              Un proyecto de la Consejería de Educación.
            </p>
          </div>

          <div class="flex flex-col sm:flex-row gap-8">
            <div>
              <h3 class="text-xs font-semibold text-[#191c1e] uppercase tracking-wider mb-3">Secciones</h3>
              <ul class="space-y-2">
                <li><a href="/" class="text-sm text-[#444653] hover:text-[#002068] transition-colors duration-200 cursor-pointer">Inicio</a></li>
                <li><a href="/podcasts" class="text-sm text-[#444653] hover:text-[#002068] transition-colors duration-200 cursor-pointer">Podcasts</a></li>
              </ul>
            </div>
            <div>
              <h3 class="text-xs font-semibold text-[#191c1e] uppercase tracking-wider mb-3">Legal</h3>
              <ul class="space-y-2">
                <li><span class="text-sm text-[#747684]">Aviso Legal</span></li>
                <li><span class="text-sm text-[#747684]">Privacidad</span></li>
                <li><span class="text-sm text-[#747684]">Accesibilidad</span></li>
              </ul>
            </div>
          </div>
        </div>

        <div class="mt-8 pt-6 border-t border-[#e0e3e5] text-center">
          <p class="text-xs text-[#747684]">
            © Gobierno de Canarias. Consejería de Educación, Formación Profesional, Actividad Física y Deportes.
          </p>
        </div>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      btn?.addEventListener('click', () => {
        const isOpen = !menu?.classList.contains('hidden');
        menu?.classList.toggle('hidden');
        btn.setAttribute('aria-expanded', String(!isOpen));
      });
    </script>
  </body>
</html>
