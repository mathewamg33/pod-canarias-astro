---
import BaseLayout from '../layouts/BaseLayout.astro';
import PodcastCard from '../components/PodcastCard.astro';
import { getCollection } from 'astro:content';

const allPodcasts = await getCollection('podcasts');
const episodes = allPodcasts.sort((a, b) => {
  const orderA = a.data.episodeOrder ?? 99;
  const orderB = b.data.episodeOrder ?? 99;
  if (orderA !== orderB) return orderA - orderB;
  return a.data.date.getTime() - b.data.date.getTime();
});
---

<BaseLayout title="Inicio" description="Proyecto de podcast escolar del alumnado de 5º de Primaria del CEIP Mirador del Mar.">

  <!-- Hero -->
  <section class="bg-white border-b border-[#e0e3e5]">
    <div class="max-w-[1200px] mx-auto px-6 py-16 md:py-20">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <h1 class="text-4xl md:text-5xl font-bold text-[#191c1e] leading-tight mb-2">
            SOMOS<br /><span class="text-[#002068]">LA VOZ</span>
          </h1>
          <p class="text-base font-semibold text-[#444653] mb-1">5º de Primaria</p>
          <p class="text-sm font-semibold text-[#002068] tracking-wide mb-5">CEIP MIRADOR DEL MAR</p>
          <p class="text-lg text-[#444653] leading-relaxed mb-8 max-w-md">
            Educación en Valores Cívicos y Éticos · Lengua Castellana y Literatura.
            Ocho episodios grabados por el alumnado durante el curso 2025-2026.
          </p>
          <div class="flex flex-wrap gap-3">
            <a
              href="/podcasts"
              class="inline-flex items-center gap-2 bg-[#002068] text-white font-semibold px-6 py-3 rounded hover:bg-[#003399] transition-colors duration-200 cursor-pointer"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="white" aria-hidden="true">
                <polygon points="5,3 19,12 5,21"/>
              </svg>
              Explorar episodios
            </a>
            <a
              href="/podcasts"
              class="inline-flex items-center gap-2 border border-[#002068] text-[#002068] font-semibold px-6 py-3 rounded hover:bg-[#f2f4f6] transition-colors duration-200 cursor-pointer"
            >
              Saber más
            </a>
          </div>
        </div>

        <!-- Ilustración -->
        <div class="hidden md:flex justify-center">
          <div class="relative w-80 h-64 bg-gradient-to-br from-[#eceef0] to-[#e0e3e5] rounded-lg flex items-center justify-center border border-[#c4c5d5]">
            <div class="text-center">
              <div class="w-20 h-20 bg-[#002068] rounded-full flex items-center justify-center mx-auto mb-4">
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" aria-hidden="true">
                  <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
                  <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
                  <line x1="12" y1="19" x2="12" y2="23"/>
                  <line x1="8" y1="23" x2="16" y2="23"/>
                </svg>
              </div>
              <p class="text-sm text-[#444653] font-semibold">SOMOS LA VOZ</p>
              <p class="text-xs text-[#747684] mt-1">5º Primaria · CEIP Mirador del Mar</p>
            </div>
            <!-- Ondas decorativas -->
            <div class="absolute -right-3 top-1/2 -translate-y-1/2 flex flex-col gap-1">
              {[32, 48, 40, 52, 36].map((h) => (
                <div class="w-1 bg-[#002068] rounded-full opacity-20" style={`height: ${h}px`}></div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Episodios -->
  <section class="max-w-[1200px] mx-auto px-6 py-14">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-2xl font-semibold text-[#191c1e]">Los 8 episodios</h2>
      <a
        href="/podcasts"
        class="text-sm font-semibold text-[#002068] hover:text-[#003399] transition-colors duration-200 cursor-pointer flex items-center gap-1"
      >
        Ver todos
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <polyline points="9,18 15,12 9,6"/>
        </svg>
      </a>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {episodes.map((podcast) => (
        <PodcastCard
          slug={podcast.id}
          title={podcast.data.title}
          school={podcast.data.school}
          date={podcast.data.date}
          subject={podcast.data.subject}
          level={podcast.data.level}
          duration={podcast.data.duration}
          description={podcast.data.description}
          episodeOrder={podcast.data.episodeOrder}
        />
      ))}
    </div>
  </section>

  <!-- Banner -->
  <section class="bg-[#002068] text-white">
    <div class="max-w-[1200px] mx-auto px-6 py-12 text-center">
      <h2 class="text-2xl font-semibold mb-3">Un proyecto del CEIP Mirador del Mar</h2>
      <p class="text-[#b5c4ff] max-w-2xl mx-auto leading-relaxed">
        <strong class="text-white">SOMOS LA VOZ</strong> es un proyecto interdisciplinar de Educación en Valores Cívicos y Lengua Castellana desarrollado por el alumnado de 5º de Primaria durante el curso 2025-2026, en el marco de la programación didáctica del centro.
      </p>
    </div>
  </section>

</BaseLayout>
