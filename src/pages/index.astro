---
import BaseLayout from '../layouts/BaseLayout.astro';
import PodcastCard from '../components/PodcastCard.astro';
import { getCollection } from 'astro:content';

const allPodcasts = await getCollection('podcasts');
const episodes = allPodcasts.sort((a, b) => {
  const orderA = a.data.episodeOrder ?? 99;
  const orderB = b.data.episodeOrder ?? 99;
  if (orderA !== orderB) return orderA - orderB;
  return a.data.date.getTime() - b.data.date.getTime();
});
---

<BaseLayout title="Inicio" description="Proyecto de podcast escolar del alumnado de 5º de Primaria del CEIP Mirador del Mar.">

  <!-- Hero -->
  <section class="bg-white border-b border-[#e0e3e5]">
    <div class="max-w-[1200px] mx-auto px-6 py-12 md:py-16">
      <div class="grid md:grid-cols-2 gap-10 items-center">

        <!-- Texto -->
        <div>
          <p class="text-xs font-semibold text-[#D4A017] uppercase tracking-widest mb-3">Proyecto de podcast escolar</p>
          <h1 class="text-5xl md:text-6xl font-bold text-[#191c1e] leading-none mb-2">
            SOMOS<br /><span class="text-[#002068]">LA VOZ</span>
          </h1>
          <p class="text-base font-semibold text-[#444653] mb-1">5º de Primaria</p>
          <p class="text-sm text-[#D4A017] font-bold tracking-wide mb-5">CEIP MIRADOR DEL MAR</p>
          <p class="text-base text-[#444653] leading-relaxed mb-8 max-w-sm">
            Educación en Valores Cívicos y Éticos · Lengua Castellana y Literatura.<br />
            Ocho episodios grabados por el alumnado durante el curso 2025-2026.
          </p>
          <div class="flex flex-wrap gap-3">
            <a
              href="/podcasts"
              class="inline-flex items-center gap-2 bg-[#002068] text-white font-semibold px-6 py-3 rounded hover:bg-[#003399] transition-colors duration-200 cursor-pointer"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="white" aria-hidden="true">
                <polygon points="5,3 19,12 5,21"/>
              </svg>
              Escuchar episodios
            </a>
            <a
              href="/podcasts"
              class="inline-flex items-center gap-2 border border-[#D4A017] text-[#D4A017] font-semibold px-6 py-3 rounded hover:bg-[#fdf8ec] transition-colors duration-200 cursor-pointer"
            >
              Ver todos
            </a>
          </div>
        </div>

        <!-- Portada -->
        <div class="flex justify-center">
          <img
            src="/images/portada-somos-la-voz.png"
            alt="¡Somos la Voz! — micrófono retro y auriculares, 5º Primaria CEIP Mirador del Mar"
            class="max-h-[420px] w-auto object-contain drop-shadow-lg"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Cita motivacional (ON AIR) -->
  <section class="bg-[#f8f9fb] border-b border-[#e0e3e5]">
    <div class="max-w-[800px] mx-auto px-6 py-10 flex flex-col sm:flex-row items-center gap-8">
      <img
        src="/images/contraportada-on-air.png"
        alt="Cartel ON AIR"
        class="w-32 sm:w-40 flex-shrink-0 object-contain"
        loading="lazy"
      />
      <blockquote class="text-center sm:text-left">
        <p class="text-lg md:text-xl font-semibold text-[#191c1e] leading-snug italic">
          «Ni el silencio más profundo puede apagar tu luz cuando encuentras tu propia voz»
        </p>
        <footer class="mt-3 text-sm text-[#D4A017] font-bold tracking-wide">SOMOS LA VOZ · 5º Primaria</footer>
      </blockquote>
    </div>
  </section>

  <!-- Todos los episodios -->
  <section class="max-w-[1200px] mx-auto px-6 py-14">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-2xl font-bold text-[#191c1e]">Los 8 episodios</h2>
        <p class="text-sm text-[#747684] mt-1">Del más antiguo al más reciente</p>
      </div>
      <a
        href="/podcasts"
        class="text-sm font-semibold text-[#002068] hover:text-[#003399] transition-colors duration-200 cursor-pointer flex items-center gap-1"
      >
        Ver todos
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <polyline points="9,18 15,12 9,6"/>
        </svg>
      </a>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {episodes.map((podcast) => (
        <PodcastCard
          slug={podcast.id}
          title={podcast.data.title}
          school={podcast.data.school}
          date={podcast.data.date}
          subject={podcast.data.subject}
          level={podcast.data.level}
          duration={podcast.data.duration}
          description={podcast.data.description}
          episodeOrder={podcast.data.episodeOrder}
        />
      ))}
    </div>
  </section>

  <!-- Banner proyecto -->
  <section class="bg-[#002068] text-white">
    <div class="max-w-[1200px] mx-auto px-6 py-12 text-center">
      <h2 class="text-2xl font-bold mb-3">Un proyecto del CEIP Mirador del Mar</h2>
      <p class="text-[#b5c4ff] max-w-2xl mx-auto leading-relaxed">
        <strong class="text-white">SOMOS LA VOZ</strong> es un proyecto interdisciplinar de Educación en Valores Cívicos y Lengua Castellana desarrollado por el alumnado de 5º de Primaria durante el curso 2025-2026, en el marco de la programación didáctica del centro.
      </p>
    </div>
  </section>

</BaseLayout>
